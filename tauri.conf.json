{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Files",
  "version": "0.1.0",
  "identifier": "app.drawer.files",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Files",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
